{
  "expo": {
    "name": "orbital-mentorship",
    "slug": "orbital-mentorship",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/logo.png",
    "scheme": "orbitalmentorship",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.orbital-mentorship",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./app/assets/logo.png",
        "backgroundImage": "./app/assets/logo.png",
        "monochromeImage": "./app/assets/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/logo.png"
    },
    "plugins": [
      [
        "react-native-auth0",
        {
          "domain": "dev-r4ni6rpttlphjtpa.us.auth0.com",
          "customScheme": "orbitalmentorship"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/logotransparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
